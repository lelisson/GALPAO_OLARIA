# Copie para secrets.toml (local) ou cadastre no Streamlit Cloud → Secrets.
# NUNCA commite secrets.toml com chaves reais.

[omie]
app_key = "SUA_APP_KEY"
app_secret = "SEU_APP_SECRET"

[auth]
# true = exige senha antes de abrir o painel (recomendado online)
habilitado = true
senha = "defina_uma_senha_forte_interna"
